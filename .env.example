# Kopieren nach .env und eigene Werte eintragen. Die Datei .env nie committen.
POSTGRES_PASSWORD=change-me-database-password

# Gemeinsames Passwort für die App, mindestens 8 Zeichen
APP_PASSWORD=change-me-app-password

# Mindestens 32 Zeichen, zum Beispiel: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-value-with-32-characters

# Lokal über http://localhost auf false, hinter HTTPS immer true
COOKIE_SECURE=false
